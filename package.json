{
  "name": "booth-atelier",
  "version": "1.2.0",
  "description": "Booth Atelier - 独立的 BOOTH 素材库管理工具",
  "main": "out/main/index.js",
  "author": {
    "name": "minoriazure",
    "url": "https://github.com/minoriazure"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --dir && node scripts/build-portable.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "script": "tsx",
    "test": "vitest run"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "electron-log": "^5.4.0",
    "sharp": "^0.35.5",
    "sql.js": "^1.11.0",
    "tough-cookie": "^5.1.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.3",
    "@vitejs/plugin-react": "^6.1.2",
    "7zip-bin": "^5.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "encoding-sniffer": "^1.0.2",
    "@electron/asar": "^4.3.1",
    "@electron/get": "^5.1.0",
    "temp": {
      "rimraf": "^6.1.2"
    }
  },
  "build": {
    "appId": "pm.booth.atelier",
    "productName": "Booth Atelier",
    "electronLanguages": [
      "zh-CN",
      "zh-TW",
      "ja",
      "ko",
      "en-US"
    ],
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "package.json",
      "!node_modules/sql.js/dist/sql-asm*",
      "!node_modules/sql.js/dist/worker.*",
      "!node_modules/sql.js/dist/sql-wasm-debug*",
      "!node_modules/sql.js/dist/sql-wasm-browser*",
      "!node_modules/sql.js/dist/sqljs-*.zip"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
