{
  "name": "booth-atelier",
  "version": "1.1.0",
  "description": "Booth Atelier - 独立的 BOOTH 素材库管理工具",
  "main": "out/main/index.js",
  "author": "user",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --dir && node scripts/build-portable.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "script": "tsx",
    "test": "vitest run"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "electron-log": "^5.4.0",
    "sql.js": "^1.11.0",
    "tough-cookie": "^5.1.2",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.3",
    "@vitejs/plugin-react": "^4.3.0",
    "7zip-bin": "^5.2.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "build": {
    "appId": "pm.booth.atelier",
    "productName": "Booth Atelier",
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}